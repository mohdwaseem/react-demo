# Loaded by `npm run build` and `npm start` (NODE_ENV=production).
# scripts/build-frontend.ps1 overrides NEXT_PUBLIC_API_BASE_URL with -ApiBaseUrl at build time.
# API_BASE_URL can be overridden on the server with a real environment variable at runtime.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5080
API_BASE_URL=http://localhost:5080
