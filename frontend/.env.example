# -------------------------------------------------------------------------------------
#  Environment variables for the Next.js app. Copy to .env.local to override locally.
#  GUIDE: docs/guide/09-integrating-backend-apis.md#environment-variables
# -------------------------------------------------------------------------------------

# Used by code running in the BROWSER (Client Components).
# NEXT_PUBLIC_* values are copied into the JavaScript bundle at BUILD time,
# so changing them later requires a new `npm run build`.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5080

# Used by code running on the NEXT.JS SERVER (Server Components, Server Actions).
# Read at RUNTIME, so it can differ per server without rebuilding.
# Never exposed to the browser: safe for internal URLs.
API_BASE_URL=http://localhost:5080
