{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=EmployeeDemoDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=False"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },
  "Jwt": {
    "Issuer": "EmployeeDemo.Api",
    "Audience": "EmployeeDemo.Web",
    "Key": "DEV-ONLY-change-me-this-key-must-be-at-least-32-chars!",
    "ExpiryMinutes": 120
  },
  "DemoUsers": [
    { "Username": "admin", "Password": "Admin@123", "Role": "Admin" }
  ],
  "Database": {
    "MigrateOnStartup": false,
    "SeedDemoData": false
  }
}
